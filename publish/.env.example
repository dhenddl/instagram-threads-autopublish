# 이 파일을 .env 로 복사한 뒤 값을 채우세요.
#   cp .env.example .env
#
# ⚠️ .env 는 절대 커밋하지 마세요. (.gitignore 처리돼 있습니다)
# ⚠️ 토큰은 비밀번호와 같습니다. 스크린샷·영상에도 찍히지 않게 하세요.

# ─────────────────────────────────────────────────────────────
# 필수 — Instagram
# Meta 개발자 대시보드 > "Instagram 로그인이 포함된 API" 설정 >
# 액세스 토큰 생성 > Generate token 으로 발급한 장기 토큰(60일)
# ─────────────────────────────────────────────────────────────
IG_ACCESS_TOKEN=

# ─────────────────────────────────────────────────────────────
# 필수 — Threads (스레드 동시 발행용, 인스타와 별도 토큰입니다)
# Threads API 액세스 이용 사례 > 설정 > 토큰 생성 으로 발급한 장기 토큰(60일)
# ─────────────────────────────────────────────────────────────
THREADS_ACCESS_TOKEN=

# ─────────────────────────────────────────────────────────────
# 선택 — App ID / Secret (같은 설정 화면에 표시됩니다)
# refresh-tokens.mjs 는 토큰만으로 갱신되므로 비워두어도 동작합니다.
# ─────────────────────────────────────────────────────────────
IG_APP_ID=
IG_APP_SECRET=

# ─────────────────────────────────────────────────────────────
# 필수 — 이미지 호스팅 (GitHub raw)
# 인스타 Graph API는 "공개 URL"로만 이미지를 받습니다. 로컬 파일은 안 됩니다.
# 이미지를 올려둘 별도 공개 저장소를 하나 만들고 그 정보를 적으세요.
#   GH_USER = 깃허브 사용자명
#   GH_REPO = 이미지 저장용 저장소 이름 (예: my-assets)
# ─────────────────────────────────────────────────────────────
GH_USER=
GH_REPO=
